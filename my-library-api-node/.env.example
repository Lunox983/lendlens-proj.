# Email Configuration (Gmail App Password)
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your-app-password

# JWT Secret (ควรใช้ค่าที่ซับซ้อนและยาวกว่านี้สำหรับ Production)
JWT_SECRET=your-jwt-secret-key-here

# CORS Origins (คั่นด้วย comma)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Database (optional — default ใช้ localhost/root/no-password/database_libraries)
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=database_libraries

# Server Port (optional — default 5000)
# PORT=5000
